<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox minHeight="500.0" minWidth="700.0" prefHeight="750.0" prefWidth="1000.0" spacing="12.0" styleClass="bg_home" stylesheets="@../css/UserStyle.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.inf008.plugins.controller.UserViewController">

    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #111826;" stylesheets="@../css/UserStyle.css">
            <children>
                <FontIcon iconColor="WHITE" iconLiteral="mdi2b-book-open-page-variant-outline" iconSize="25">
                    <HBox.margin>
                        <Insets right="10.0" />
                    </HBox.margin>
                </FontIcon>
                <Label styleClass="section-title" text="User management" textFill="WHITE">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets left="10.0" />
            </padding>
        </HBox>

        <TitledPane animated="true" expanded="false" style="-fx-background-color: #4D818C;" stylesheets="@../css/UserStyle.css" text="User Register" VBox.vgrow="NEVER">
            <content>
                <VBox spacing="12.0" style="-fx-background-color: #4D818C;" stylesheets="@../css/UserStyle.css">
                    <children>
                        <GridPane hgap="10.0" stylesheets="@../css/UserStyle.css" vgap="10.0">
                            <children>
                                <Label styleClass="field-label" text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="txtName" prefWidth="180.0" promptText="Type your name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <Label styleClass="field-label" text="Email:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                <TextField fx:id="txtEmail" prefWidth="200.0" promptText="Digite o email..." GridPane.columnIndex="3" GridPane.rowIndex="0" />
                            </children>
                            <columnConstraints>
                                <ColumnConstraints minWidth="60.0" prefWidth="60.0" />
                                <ColumnConstraints minWidth="180.0" prefWidth="180.0" />
                                <ColumnConstraints minWidth="60.0" prefWidth="60.0" />
                                <ColumnConstraints minWidth="200.0" prefWidth="200.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button fx:id="btnSave" mnemonicParsing="false" onAction="#btnSaveOnAction" prefWidth="100.0" styleClass="button-success" text="Register" />
                                <Button fx:id="btnCancel" mnemonicParsing="false" onAction="#btnCancelOnAction" prefWidth="100.0" styleClass="button-warning" text="Cancel" visible="false" />
                            </children>
                        </HBox>
                        <Label fx:id="lblMessage" styleClass="subtitle" />
                    </children>
                </VBox>
            </content>
        </TitledPane>

        <TitledPane animated="true" expanded="false" styleClass="container_style" text="Search and Management" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="12.0" styleClass="search-container">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ComboBox fx:id="cmbSearchType" prefWidth="100.0" promptText="Filter" />
                                <TextField fx:id="txtSearch" prefWidth="200.0" promptText="Pesquisar..." HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnClear" mnemonicParsing="false" onAction="#btnClearOnAction" prefWidth="70.0" styleClass="button-warning" text="Clean" />
                                <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#btnSearchOnAction" prefWidth="70.0" styleClass="button-primary" text="Search" />
                            </children>
                        </HBox>
                        <TableView fx:id="tableUsers" prefHeight="350.0" VBox.vgrow="ALWAYS" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button fx:id="btnRefresh" mnemonicParsing="false" prefWidth="80.0" styleClass="button-primary" text="Update" onAction="#btnRefreshOnAction" />
                                <Button fx:id="btnEdit" mnemonicParsing="false" prefWidth="70.0" styleClass="button-warning" text="Edit" onAction="#btnEditOnAction" />
                                <Button fx:id="btnDelete" mnemonicParsing="false" prefWidth="70.0" styleClass="button-danger" text="Delete" onAction="#btnDeleteOnAction" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </TitledPane>
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" stylesheets="@../css/UserStyle.css" />
    </children>
</VBox>