<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="600.0" prefWidth="900.0" styleClass="bg_home" stylesheets="@../css/UserStyle.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.inf008.plugins.controller.UserRegistrationController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #111826;" styleClass="home_app_bar" BorderPane.alignment="CENTER">
         <children>
            <FontIcon iconColor="WHITE" iconLiteral="mdi2b-book-open-page-variant-outline" iconSize="25">
               <HBox.margin>
                  <Insets left="20.0" right="10.0" />
               </HBox.margin>
            </FontIcon>
            <Label text="LIBRARY" textFill="WHITE">
               <font>
                  <Font name="System Italic" size="16.0" />
               </font>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Label>
            <Pane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Pane>
            <MenuBar styleClass="menu_app_bar">
              <menus>
                <Menu mnemonicParsing="false">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#handleMenuProfile" text="Menu Item" />
                  </items>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2b-bell" iconSize="25" onMouseClicked="#handleMenu" styleClass="menu_app_bar" />
                     </graphic>
                </Menu>
                <Menu mnemonicParsing="false">
                  <items>
                    <MenuItem mnemonicParsing="false" text="User" />
                  </items>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2a-account" iconSize="26" styleClass="menu_app_bar" />
                     </graphic>
                </Menu>
              </menus>
            </MenuBar>
         </children>
      </HBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="200.0" spacing="10.0" styleClass="container_style">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <children>
                  <FontIcon iconColor="WHITE" iconLiteral="mdi2a-account-multiple" iconSize="20" />
                  <Label text="Users" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label layoutX="50.0" layoutY="23.0" text="&gt;" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label layoutX="94.0" layoutY="23.0" text="User Registration" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Pane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <Label text="Back" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2r-reply" iconSize="15" />
                     </graphic>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Label>
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding></HBox>
            <VBox prefHeight="435.0" prefWidth="730.0" styleClass="container_style" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="shadow" text="User Registration Form" textFill="WHITE">
                     <padding>
                        <Insets left="10.0" top="10.0" />
                     </padding>
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="200.0" spacing="15.0">
                     <children>
                        <Label alignment="TOP_LEFT" text="Name:" textFill="WHITE">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <TextField onAction="#handlerRegisterButton" promptText="Users" HBox.hgrow="ALWAYS">
                           <font>
                              <Font size="16.0" />
                           </font></TextField>
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="45.0" prefHeight="60.0" prefWidth="200.0" spacing="15.0">
                     <children>
                        <Label alignment="TOP_LEFT" text="Email:" textFill="WHITE">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <TextField onAction="#handlerRegisterButton" promptText="Email" HBox.hgrow="ALWAYS">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </TextField>
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="105.0" prefHeight="60.0" prefWidth="200.0" spacing="15.0">
                     <children>
                        <Label alignment="TOP_LEFT" text="Date" textFill="WHITE">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <TextField onAction="#handlerRegisterButton" promptText="yyyy-MM-dd" HBox.hgrow="ALWAYS">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </TextField>
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </HBox>
                  <AnchorPane prefWidth="200.0">
                     <children>
                        <Button mnemonicParsing="false" onMouseClicked="#handlerRegisterButton" text="RESGISTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
                     </children>
                     <VBox.margin>
                        <Insets left="10.0" right="10.0" />
                     </VBox.margin>
                  </AnchorPane>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
